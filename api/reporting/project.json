{
  "name": "reporting-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "api/reporting/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project reporting-api --web",
